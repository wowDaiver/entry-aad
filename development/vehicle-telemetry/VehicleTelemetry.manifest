<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>VehicleTelemetry</name>
  <type>App</type>
  <file>{pluginDir}/VehicleTelemetry</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector><type>Etch</type><id>0</id><asyncCallbacks>yes</asyncCallbacks></pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/VehicleTelemetry.xml</DescFile>
      <TextDBFile>{pluginDir}/VehicleTelemetry_Texts.zip</TextDBFile>
      <ImageDBFile>{pluginDir}/VehicleTelemetry_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>
